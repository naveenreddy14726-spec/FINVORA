# Copy to .env (backend, repo root) and frontend/.env.local (frontend). Never commit real values.

APP_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Supabase ---
# Browser-safe values (used by the frontend, put these in frontend/.env.local too)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only values (backend only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Providers (chosen in Phases 7, 9, 10) ---
MARKET_DATA_API_KEY=
NEWS_API_KEY=
LLM_API_KEY=

# --- Razorpay (use TEST mode keys during development) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# If true, admin APIs require an MFA-verified session (set true once admin MFA is enrolled)
ADMIN_REQUIRE_MFA=false
